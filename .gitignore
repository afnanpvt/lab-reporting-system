# Dependencies
node_modules/

# Build output
out/
dist/
release/

# Local database — regenerated automatically on first run, contains local patient data
lab-data.db
lab-data.db-journal

# Vendor profiles — only the generic demo profile ships in the repo (see profiles/README.md);
# every other profile (a real customer's name, logo, signed license) stays local.
/profiles/*
!/profiles/demo/
!/profiles/README.md

# Staged branding/license/logo — whatever profiles/apply-profile.js last staged here for the
# local dev run or build. Regenerated from a profile, never hand-edited, never committed.
resources/branding.json
resources/license.json
resources/logo.png

# Logs
*.log
npm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.local
.env*.local
