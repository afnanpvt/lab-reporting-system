# Dependencies
node_modules/

# Build output
out/
dist/
release/

# Local database — regenerated automatically on first run, contains local patient data
lab-data.db
lab-data.db-journal

# Vendor profiles and licenses/ledger.csv are committed on purpose: this repo is private and both
# founders build from it. The private signing key never is.

# A license key pasted into a dev run (packaged builds keep it in %APPDATA%\LumaLabs instead)
license-activated.json

# Staged branding/license/logo — whatever profiles/apply-profile.js last staged here for the
# local dev run or build. Regenerated from a profile, never hand-edited, never committed.
resources/branding.json
resources/license.json
resources/logo.png
resources/.profile-name

# Logs
*.log
npm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.local
.env*.local
